<?xml version="1.0"?>
<ruleset name="Tiles Proxy for OpenStreetMap">
    <description>WordPress Coding Standards checks for security, WordPress APIs and PHP compatibility. Formatting is not enforced.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/libs/*</exclude-pattern>
    <exclude-pattern>/.wordpress-org/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.0"/>
    <config name="testVersion" value="8.0-"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.WP">
        <!-- Tiles are cached during frontend requests, where WP_Filesystem is not available -->
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_rmdir"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
        <exclude name="WordPress.WP.AlternativeFunctions.rename_rename"/>
    </rule>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.PHP">
        <exclude name="WordPress.PHP.POSIXFunctions"/>
    </rule>
    <rule ref="WordPress.CodeAnalysis"/>
    <rule ref="WordPress.DateTime"/>
    <rule ref="WordPress.Utils"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="osm-tiles-proxy"/>
            </property>
        </properties>
    </rule>
</ruleset>
